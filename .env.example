# Copia este archivo como .env y ajusta los valores.
# No agregues secretos reales al repositorio.

# Por defecto se usa el unishort.db de la raíz del repositorio.
# UNISHORT_DATABASE_URL=sqlite:///C:/ruta/absoluta/unishort.db
UNISHORT_BASE_URL=http://localhost:8000
# Vacía: administración deshabilitada (503). Definir temporalmente con Read-Host.
UNISHORT_ADMIN_API_KEY=
UNISHORT_RATE_LIMIT_ENABLED=true
UNISHORT_RATE_LIMIT_MAX=60
UNISHORT_RATE_LIMIT_WINDOW_SECONDS=60
UNISHORT_SHORT_CODE_LENGTH=7
UNISHORT_QR_BOX_SIZE=10
UNISHORT_QR_BORDER=4
UNISHORT_LOG_LEVEL=INFO
UNISHORT_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
