<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UniShort" targetNamespace="https://unishort.example/bpmn" exporter="UniShort QR" exporterVersion="2026-11-06">
  <bpmn:collaboration id="Collaboration_Create">
    <bpmn:participant id="Participant_Create" name="Crear enlace corto (POST /api/v1/links)" processRef="Process_Create" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Create" name="Crear enlace corto (POST /api/v1/links)" isExecutable="false">
    <bpmn:documentation>Flujo público sin autenticación. Unicidad en SQL; hasta diez intentos. Devuelve qr_url, no PNG. No se consulta el destino.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Create">
      <bpmn:lane id="Lane_Create_user" name="Persona usuaria / administrador">
        <bpmn:flowNodeRef>Create_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Create_api" name="Backend FastAPI y panel web">
        <bpmn:flowNodeRef>Create_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Generate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_InvalidEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create_FailureEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Create_qr" name="Biblioteca QR local (mismo backend)" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Create_Start" name="Necesidad de compartir un recurso">
      <bpmn:outgoing>Create_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Create_Input" name="Introducir URL y caducidad opcional">
      <bpmn:incoming>Create_flow_0</bpmn:incoming>
      <bpmn:outgoing>Create_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Create_Validate" name="Validar solicitud y aplicar límite">
      <bpmn:incoming>Create_flow_1</bpmn:incoming>
      <bpmn:outgoing>Create_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Create_Valid" name="¿Solicitud aceptada?" default="Create_flow_4">
      <bpmn:incoming>Create_flow_2</bpmn:incoming>
      <bpmn:outgoing>Create_flow_3</bpmn:outgoing>
      <bpmn:outgoing>Create_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create_Generate" name="Generar código aleatorio">
      <bpmn:incoming>Create_flow_3</bpmn:incoming>
      <bpmn:outgoing>Create_flow_6</bpmn:outgoing>
      <bpmn:incoming>Create_flow_11</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Create_Persist" name="Intentar insertar y confirmar enlace">
      <bpmn:incoming>Create_flow_6</bpmn:incoming>
      <bpmn:outgoing>Create_flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Create_Result" name="¿Resultado de persistencia?" default="Create_flow_10">
      <bpmn:incoming>Create_flow_7</bpmn:incoming>
      <bpmn:outgoing>Create_flow_8</bpmn:outgoing>
      <bpmn:outgoing>Create_flow_9</bpmn:outgoing>
      <bpmn:outgoing>Create_flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Create_Retry" name="¿Quedan intentos de los diez?" default="Create_flow_12">
      <bpmn:incoming>Create_flow_9</bpmn:incoming>
      <bpmn:outgoing>Create_flow_11</bpmn:outgoing>
      <bpmn:outgoing>Create_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create_Return" name="Devolver 201 con URL corta y qr_url">
      <bpmn:incoming>Create_flow_8</bpmn:incoming>
      <bpmn:outgoing>Create_flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Create_Display" name="Consultar enlace creado">
      <bpmn:incoming>Create_flow_15</bpmn:incoming>
      <bpmn:outgoing>Create_flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Create_End" name="Enlace creado sin generar PNG">
      <bpmn:incoming>Create_flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Create_Invalid" name="Devolver 400, 422 o 429 sin insertar">
      <bpmn:incoming>Create_flow_4</bpmn:incoming>
      <bpmn:outgoing>Create_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Create_InvalidEnd" name="Solicitud rechazada">
      <bpmn:incoming>Create_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Create_Conflict" name="Devolver 409 tras agotar colisiones">
      <bpmn:incoming>Create_flow_12</bpmn:incoming>
      <bpmn:outgoing>Create_flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Create_Failure" name="Revertir y devolver error 500">
      <bpmn:incoming>Create_flow_10</bpmn:incoming>
      <bpmn:outgoing>Create_flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Create_FailureEnd" name="Creación no confirmada">
      <bpmn:incoming>Create_flow_13</bpmn:incoming>
      <bpmn:incoming>Create_flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Create_flow_0" sourceRef="Create_Start" targetRef="Create_Input" />
    <bpmn:sequenceFlow id="Create_flow_1" sourceRef="Create_Input" targetRef="Create_Validate" />
    <bpmn:sequenceFlow id="Create_flow_2" sourceRef="Create_Validate" targetRef="Create_Valid" />
    <bpmn:sequenceFlow id="Create_flow_3" sourceRef="Create_Valid" targetRef="Create_Generate" name="Aceptada" />
    <bpmn:sequenceFlow id="Create_flow_4" sourceRef="Create_Valid" targetRef="Create_Invalid" name="Por defecto" />
    <bpmn:sequenceFlow id="Create_flow_5" sourceRef="Create_Invalid" targetRef="Create_InvalidEnd" />
    <bpmn:sequenceFlow id="Create_flow_6" sourceRef="Create_Generate" targetRef="Create_Persist" />
    <bpmn:sequenceFlow id="Create_flow_7" sourceRef="Create_Persist" targetRef="Create_Result" />
    <bpmn:sequenceFlow id="Create_flow_8" sourceRef="Create_Result" targetRef="Create_Return" name="Commit confirmado" />
    <bpmn:sequenceFlow id="Create_flow_9" sourceRef="Create_Result" targetRef="Create_Retry" name="IntegrityError y rollback" />
    <bpmn:sequenceFlow id="Create_flow_10" sourceRef="Create_Result" targetRef="Create_Failure" name="Por defecto" />
    <bpmn:sequenceFlow id="Create_flow_11" sourceRef="Create_Retry" targetRef="Create_Generate" name="Intentos &lt; 10" />
    <bpmn:sequenceFlow id="Create_flow_12" sourceRef="Create_Retry" targetRef="Create_Conflict" name="Por defecto" />
    <bpmn:sequenceFlow id="Create_flow_13" sourceRef="Create_Conflict" targetRef="Create_FailureEnd" />
    <bpmn:sequenceFlow id="Create_flow_14" sourceRef="Create_Failure" targetRef="Create_FailureEnd" />
    <bpmn:sequenceFlow id="Create_flow_15" sourceRef="Create_Return" targetRef="Create_Display" />
    <bpmn:sequenceFlow id="Create_flow_16" sourceRef="Create_Display" targetRef="Create_End" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_QR">
    <bpmn:participant id="Participant_QR" name="Obtener PNG bajo demanda (GET /api/v1/links/{code}/qr)" processRef="Process_QR" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QR" name="Obtener PNG bajo demanda (GET /api/v1/links/{code}/qr)" isExecutable="false">
    <bpmn:documentation>Solicitud independiente de la creación. Biblioteca QR en el mismo backend; contenido igual a short_url. Fallo de generación: 500 controlado.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_QR">
      <bpmn:lane id="Lane_QR_user" name="Persona usuaria / administrador">
        <bpmn:flowNodeRef>QR_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QR_api" name="Backend FastAPI y panel web">
        <bpmn:flowNodeRef>QR_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_Usable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QR_ErrorEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QR_qr" name="Biblioteca QR local (mismo backend)">
        <bpmn:flowNodeRef>QR_Generate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="QR_Start" name="Necesidad de ver o descargar QR">
      <bpmn:outgoing>QR_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="QR_Request" name="Solicitar código QR">
      <bpmn:incoming>QR_flow_0</bpmn:incoming>
      <bpmn:outgoing>QR_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="QR_Resolve" name="Resolver código y comprobar estado">
      <bpmn:incoming>QR_flow_1</bpmn:incoming>
      <bpmn:outgoing>QR_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="QR_Usable" name="¿Enlace existente, activo y vigente?" default="QR_flow_4">
      <bpmn:incoming>QR_flow_2</bpmn:incoming>
      <bpmn:outgoing>QR_flow_3</bpmn:outgoing>
      <bpmn:outgoing>QR_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="QR_Generate" name="Generar PNG con la URL corta">
      <bpmn:incoming>QR_flow_3</bpmn:incoming>
      <bpmn:outgoing>QR_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="QR_Deliver" name="Entregar PNG sin incrementar visitas">
      <bpmn:incoming>QR_flow_5</bpmn:incoming>
      <bpmn:outgoing>QR_flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="QR_End" name="PNG disponible">
      <bpmn:incoming>QR_flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="QR_Error" name="Devolver 404 o 410 con envelope">
      <bpmn:incoming>QR_flow_4</bpmn:incoming>
      <bpmn:outgoing>QR_flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="QR_ErrorEnd" name="QR rechazado">
      <bpmn:incoming>QR_flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="QR_flow_0" sourceRef="QR_Start" targetRef="QR_Request" />
    <bpmn:sequenceFlow id="QR_flow_1" sourceRef="QR_Request" targetRef="QR_Resolve" />
    <bpmn:sequenceFlow id="QR_flow_2" sourceRef="QR_Resolve" targetRef="QR_Usable" />
    <bpmn:sequenceFlow id="QR_flow_3" sourceRef="QR_Usable" targetRef="QR_Generate" name="Sí" />
    <bpmn:sequenceFlow id="QR_flow_4" sourceRef="QR_Usable" targetRef="QR_Error" name="Por defecto" />
    <bpmn:sequenceFlow id="QR_flow_5" sourceRef="QR_Generate" targetRef="QR_Deliver" />
    <bpmn:sequenceFlow id="QR_flow_6" sourceRef="QR_Deliver" targetRef="QR_End" />
    <bpmn:sequenceFlow id="QR_flow_7" sourceRef="QR_Error" targetRef="QR_ErrorEnd" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Redirect">
    <bpmn:participant id="Participant_Redirect" name="Redirigir enlace corto (GET /s/{code})" processRef="Process_Redirect" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Redirect" name="Redirigir enlace corto (GET /s/{code})" isExecutable="false">
    <bpmn:documentation>No se obtiene contenido del destino. Un error del contador se registra sin PII y no impide redirigir. Nunca se persisten eventos individuales.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Redirect">
      <bpmn:lane id="Lane_Redirect_user" name="Persona usuaria / administrador">
        <bpmn:flowNodeRef>Redirect_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Redirect_api" name="Backend FastAPI y panel web">
        <bpmn:flowNodeRef>Redirect_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Usable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Redirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_Gone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Redirect_ErrorEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Redirect_qr" name="Biblioteca QR local (mismo backend)" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Redirect_Start" name="Acceso al enlace corto o QR escaneado">
      <bpmn:outgoing>Redirect_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Redirect_Resolve" name="Resolver código corto">
      <bpmn:incoming>Redirect_flow_0</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Redirect_Found" name="¿Código existente?" default="Redirect_flow_3">
      <bpmn:incoming>Redirect_flow_1</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_2</bpmn:outgoing>
      <bpmn:outgoing>Redirect_flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Redirect_Usable" name="¿Activo y no caducado?" default="Redirect_flow_6">
      <bpmn:incoming>Redirect_flow_2</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_5</bpmn:outgoing>
      <bpmn:outgoing>Redirect_flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Redirect_Count" name="Intentar incrementar contador agregado">
      <bpmn:incoming>Redirect_flow_5</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Redirect_Redirect" name="Redirigir con 307 y Location">
      <bpmn:incoming>Redirect_flow_8</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Redirect_End" name="Destino comunicado al navegador">
      <bpmn:incoming>Redirect_flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Redirect_Missing" name="Devolver 404 heredado">
      <bpmn:incoming>Redirect_flow_3</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Redirect_Gone" name="Devolver 410 con envelope">
      <bpmn:incoming>Redirect_flow_6</bpmn:incoming>
      <bpmn:outgoing>Redirect_flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Redirect_ErrorEnd" name="Redirección rechazada">
      <bpmn:incoming>Redirect_flow_4</bpmn:incoming>
      <bpmn:incoming>Redirect_flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Redirect_flow_0" sourceRef="Redirect_Start" targetRef="Redirect_Resolve" />
    <bpmn:sequenceFlow id="Redirect_flow_1" sourceRef="Redirect_Resolve" targetRef="Redirect_Found" />
    <bpmn:sequenceFlow id="Redirect_flow_2" sourceRef="Redirect_Found" targetRef="Redirect_Usable" name="Sí" />
    <bpmn:sequenceFlow id="Redirect_flow_3" sourceRef="Redirect_Found" targetRef="Redirect_Missing" name="Por defecto" />
    <bpmn:sequenceFlow id="Redirect_flow_4" sourceRef="Redirect_Missing" targetRef="Redirect_ErrorEnd" />
    <bpmn:sequenceFlow id="Redirect_flow_5" sourceRef="Redirect_Usable" targetRef="Redirect_Count" name="Sí" />
    <bpmn:sequenceFlow id="Redirect_flow_6" sourceRef="Redirect_Usable" targetRef="Redirect_Gone" name="Por defecto" />
    <bpmn:sequenceFlow id="Redirect_flow_7" sourceRef="Redirect_Gone" targetRef="Redirect_ErrorEnd" />
    <bpmn:sequenceFlow id="Redirect_flow_8" sourceRef="Redirect_Count" targetRef="Redirect_Redirect" name="Contador de mejor esfuerzo" />
    <bpmn:sequenceFlow id="Redirect_flow_9" sourceRef="Redirect_Redirect" targetRef="Redirect_End" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Admin">
    <bpmn:participant id="Participant_Admin" name="Consultar y gestionar desde el panel administrativo" processRef="Process_Admin" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Admin" name="Consultar y gestionar desde el panel administrativo" isExecutable="false">
    <bpmn:documentation>X-Admin-API-Key solo en cabecera. Estado/fecha no cambian el destino. Sin eliminación física. Logout cancela peticiones; cada operación exige autorización en servidor. Copiar/abrir/QR son acciones auxiliares descritas en el análisis.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Admin">
      <bpmn:lane id="Lane_Admin_user" name="Persona usuaria / administrador">
        <bpmn:flowNodeRef>Admin_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Logout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin_api" name="Backend FastAPI y panel web">
        <bpmn:flowNodeRef>Admin_Authenticate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Patch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_ErrorKind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Admin_DeniedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin_qr" name="Biblioteca QR local (mismo backend)" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Admin_Start" name="Necesidad de administrar enlaces">
      <bpmn:outgoing>Admin_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Admin_Key" name="Introducir clave provisional en memoria">
      <bpmn:incoming>Admin_flow_0</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Admin_Authenticate" name="Validar clave en GET protegido del listado">
      <bpmn:incoming>Admin_flow_1</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Admin_Authorized" name="¿Clave autorizada por el backend?" default="Admin_flow_4">
      <bpmn:incoming>Admin_flow_2</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_3</bpmn:outgoing>
      <bpmn:outgoing>Admin_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Admin_Query" name="Consultar resumen SQL y lista paginada">
      <bpmn:incoming>Admin_flow_3</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_6</bpmn:outgoing>
      <bpmn:incoming>Admin_flow_14</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:userTask id="Admin_View" name="Consultar enlaces con búsqueda y filtros">
      <bpmn:incoming>Admin_flow_6</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_7</bpmn:outgoing>
      <bpmn:incoming>Admin_flow_12</bpmn:incoming>
      <bpmn:incoming>Admin_flow_17</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Admin_Action" name="¿Gestionar o cerrar sesión?" default="Admin_flow_9">
      <bpmn:incoming>Admin_flow_7</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_8</bpmn:outgoing>
      <bpmn:outgoing>Admin_flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Admin_Edit" name="Editar estado o caducidad">
      <bpmn:incoming>Admin_flow_8</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Admin_Confirm" name="¿Confirmar cambios?" default="Admin_flow_12">
      <bpmn:incoming>Admin_flow_10</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_11</bpmn:outgoing>
      <bpmn:outgoing>Admin_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Admin_Patch" name="Revalidar clave y aplicar PATCH validado">
      <bpmn:incoming>Admin_flow_11</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Admin_Saved" name="¿Cambio confirmado?" default="Admin_flow_15">
      <bpmn:incoming>Admin_flow_13</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_14</bpmn:outgoing>
      <bpmn:outgoing>Admin_flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Admin_Error" name="Mostrar error sin revelar credenciales">
      <bpmn:incoming>Admin_flow_15</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Admin_ErrorKind" name="¿Error de autenticación?" default="Admin_flow_17">
      <bpmn:incoming>Admin_flow_16</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_17</bpmn:outgoing>
      <bpmn:outgoing>Admin_flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Admin_Logout" name="Cerrar sesión y descartar clave local">
      <bpmn:incoming>Admin_flow_9</bpmn:incoming>
      <bpmn:incoming>Admin_flow_18</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Admin_End" name="Sesión local terminada">
      <bpmn:incoming>Admin_flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Admin_Denied" name="Mostrar 401, 403 o 503 y borrar clave">
      <bpmn:incoming>Admin_flow_4</bpmn:incoming>
      <bpmn:outgoing>Admin_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Admin_DeniedEnd" name="Acceso rechazado">
      <bpmn:incoming>Admin_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Admin_flow_0" sourceRef="Admin_Start" targetRef="Admin_Key" />
    <bpmn:sequenceFlow id="Admin_flow_1" sourceRef="Admin_Key" targetRef="Admin_Authenticate" />
