    <bpmn:sequenceFlow id="Admin_flow_4" sourceRef="Admin_Authorized" targetRef="Admin_Denied" name="Por defecto" />
    <bpmn:sequenceFlow id="Admin_flow_5" sourceRef="Admin_Denied" targetRef="Admin_DeniedEnd" />
    <bpmn:sequenceFlow id="Admin_flow_6" sourceRef="Admin_Query" targetRef="Admin_View" />
