    <bpmn:sequenceFlow id="Admin_flow_9" sourceRef="Admin_Action" targetRef="Admin_Logout" name="Por defecto" />
    <bpmn:sequenceFlow id="Admin_flow_10" sourceRef="Admin_Edit" targetRef="Admin_Confirm" />
    <bpmn:sequenceFlow id="Admin_flow_11" sourceRef="Admin_Confirm" targetRef="Admin_Patch" name="Confirmar" />
    <bpmn:sequenceFlow id="Admin_flow_12" sourceRef="Admin_Confirm" targetRef="Admin_View" name="Por defecto" />
    <bpmn:sequenceFlow id="Admin_flow_13" sourceRef="Admin_Patch" targetRef="Admin_Saved" />
    <bpmn:sequenceFlow id="Admin_flow_14" sourceRef="Admin_Saved" targetRef="Admin_Query" name="Sí: refrescar" />
    <bpmn:sequenceFlow id="Admin_flow_15" sourceRef="Admin_Saved" targetRef="Admin_Error" name="Por defecto" />
    <bpmn:sequenceFlow id="Admin_flow_16" sourceRef="Admin_Error" targetRef="Admin_ErrorKind" />
